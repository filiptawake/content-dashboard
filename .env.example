# ---------------------------------------------------------------------------
# Tenfold Content OS — environment variables. Copy to .env.local and fill in.
# Every integration is OPTIONAL: with nothing set, the app runs on demo data.
# ---------------------------------------------------------------------------

# Claude / Anthropic — live caption generation (POST /api/caption).
# Unset -> deterministic demo captions from buildDemoCaption().
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8).
ANTHROPIC_MODEL=

# Supabase — persistent data layer.
# Unset -> the app reads the seed data in src/data/*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses RLS. Used by API routes and n8n writes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Zernio — multi-platform posting (wired in a later step).
# Key from https://zernio.com/dashboard/api-keys
ZERNIO_API_KEY=
